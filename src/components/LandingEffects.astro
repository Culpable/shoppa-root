  <svg viewBox="0 0 256 256" fill="currentColor"><path d="M223.68,66.15,135.68,18a15.88,15.88,0,0,0-15.36,0l-88,48.17a16,16,0,0,0-8.32,14v95.64a16,16,0,0,0,8.32,14l88,48.17a15.88,15.88,0,0,0,15.36,0l88-48.17a16,16,0,0,0,8.32-14V80.18A16,16,0,0,0,223.68,66.15ZM128,32l80.34,44-29.77,16.3-80.35-44ZM128,120,47.66,76l33.9-18.56,80.34,44ZM40,90l80,43.78v85.79L40,175.82Zm176,85.78h0l-80,43.79V133.82l32-17.51V152a8,8,0,0,0,16,0V107.55L216,90v85.77Z"/></svg>
  <svg viewBox="0 0 256 256" fill="currentColor"><path d="M72,104a8,8,0,0,1,8-8h96a8,8,0,0,1,0,16H80A8,8,0,0,1,72,104Zm8,40h96a8,8,0,0,0,0-16H80a8,8,0,0,0,0,16ZM232,56V208a8,8,0,0,1-11.58,7.15L192,200.94l-28.42,14.21a8,8,0,0,1-7.16,0L128,200.94,99.58,215.15a8,8,0,0,1-7.16,0L64,200.94,35.58,215.15A8,8,0,0,1,24,208V56A16,16,0,0,1,40,40H216A16,16,0,0,1,232,56Zm-16,0H40V195.06l20.42-10.22a8,8,0,0,1,7.16,0L96,199.06l28.42-14.22a8,8,0,0,1,7.16,0L160,199.06l28.42-14.22a8,8,0,0,1,7.16,0L216,195.06Z"/></svg>
</template>

<script>
  /* ---- chat replay: the demo sells itself ------------------------------ */

  /* Position the dots via rect difference, never offsetLeft/Top: the hidden
     message carries a transform, which silently makes it the offsetParent
     of its bubble and would strand the dots at the top of the chat. The
     10px subtraction cancels the hidden state's translateY. The pill is
     shorter than the bubble it stands in for, so it anchors to the bubble's
     settled BOTTOM edge (translateY(-100%) lifts it by its own height):
     its tail then sits exactly where the landed bubble's tail and the
     bottom-aligned avatar end up, instead of floating high on the top edge. */
  const makeTypingDots = (anchor: Element, container: Element): HTMLElement => {
    const dots = document.createElement('li');
    dots.className = 'typing-dots';
    dots.setAttribute('aria-hidden', 'true');
    dots.innerHTML = '<i></i><i></i><i></i>';
    const anchorRect = anchor.getBoundingClientRect();
    const containerRect = container.getBoundingClientRect();
    dots.style.left = `${Math.round(anchorRect.left - containerRect.left)}px`;
    dots.style.top = `${Math.round(anchorRect.bottom - containerRect.top - 10)}px`;
    dots.style.transform = 'translateY(-100%)';
    return dots;
  };

  interface ReplayOptions {
    container: Element;
    step: number;
    typeBeat: number;
    startAt: number;
    isAgent: (item: Element) => boolean;
    bubbleFor: (item: Element) => Element | null;
  }

  /* Hide every message up front (opacity only - the space stays reserved so
     the page never reflows), then show them in order. Agent turns get a
     typing beat first, overlaid on the upcoming bubble's reserved spot. */
  const playChat = (items: Element[], opts: ReplayOptions): void => {
    opts.container.classList.add('chat-replaying');
    items.forEach((item) => item.classList.add('replay-hidden'));
    let t = opts.startAt;
    items.forEach((item) => {
      if (opts.isAgent(item)) {
        const showDotsAt = t;
        setTimeout(() => {
          const dots = makeTypingDots(opts.bubbleFor(item) ?? item, opts.container);
          opts.container.appendChild(dots);
          setTimeout(() => dots.remove(), opts.typeBeat - 60);
        }, showDotsAt);
        t += opts.typeBeat;
      }
      setTimeout(() => {
        item.classList.add('replay-shown');
        item.querySelectorAll('.paid-badge').forEach((badge) => badge.classList.add('badge-stamp'));
        if (item.classList.contains('paid-badge')) item.classList.add('badge-stamp');
      }, t);
      t += opts.step;
    });
  };

  /* Hide the messages the moment the script runs, then hold the replay until
     the chat itself reaches the viewport, so it always plays under the
     reader's eye. Both chats use this: a load-timed replay only looks like the
     page introducing itself while the chat is already on screen, which the
     hero mini-chat is on desktop but not on a phone. The single-column mobile
     hero stacks the copy above the flow cards and pushes the mini-chat below
     the fold (user-reported, 2026-08-23), where a load-timed replay spent its
     typing beats and bubbles on an empty viewport and left a finished chat for
     whoever scrolled down. Where the chat is on screen at load the observer
     fires on the first frame, so the desktop lead-in is unchanged. */
  const playWhenVisible = (items: Element[], opts: ReplayOptions): void => {
    items.forEach((item) => item.classList.add('replay-hidden'));
    const replayObserver = new IntersectionObserver((entries) => {
      if (!entries.some((entry) => entry.isIntersecting)) return;
      replayObserver.disconnect();
      playChat(items, opts);
    }, { threshold: 0.22 });
    replayObserver.observe(opts.container);
  };

  /* Read every mount-time layout value before the replay, reveal, or motif
     systems write classes and styles. Interleaving these reads with writes
     made each later getBoundingClientRect and scrollHeight access flush the
     preceding style changes synchronously. Opacity and transforms do not
     affect document flow, so this single snapshot remains authoritative for
     the mutations that follow. */
  const revealMeasurements: { target: HTMLElement; delay: number; top: number }[] = [];
  document.querySelectorAll('main > section.section').forEach((section) => {
    const blocks = section.querySelectorAll<HTMLElement>(
      ':scope > .section-intro > *, :scope > h2, :scope > .agent-grid > *, :scope > .catalogue-grid > *, :scope > .timeline-grid > *, :scope > .shift-grid > *, :scope > .capabilities, :scope > .catalogue-close, :scope > .timeline-close, :scope > blockquote, :scope > footer'
    );
    blocks.forEach((target, index) => {
      revealMeasurements.push({
        target,
        delay: Math.min(index, 5) * 90,
        top: target.getBoundingClientRect().top,
      });
    });
  });
  const initialRevealBoundary = innerHeight * 0.92;
  const initialDocumentHeight = document.documentElement.scrollHeight;

  /* Hero mini-chat: the lead-in is timed to begin as its flow card lands (the
     hero enter finishes drawing the stack at ~940ms). */
  const miniChat = document.querySelector('.mini-chat');
  if (miniChat) {
    playWhenVisible([...miniChat.children], {
      container: miniChat,
      step: 460,
      typeBeat: 640,
      startAt: 600,
      isAgent: (item) => item.classList.contains('mini-agent-row'),
      bubbleFor: (item) => item.querySelector('.bubble-agent'),
    });
  }

  /* Conversation panel: always well below the fold, on every viewport. */
  const conversationList = document.querySelector('.conversation-list');
  if (conversationList) {
    playWhenVisible([...conversationList.children], {
      container: conversationList,
      step: 560,
      typeBeat: 820,
      startAt: 260,
      isAgent: (item) => item.querySelector(':scope > .avatar') !== null,
      bubbleFor: (item) => item.querySelector('.bubble-agent'),
    });
  }

  /* ---- one-shot scroll reveals ----------------------------------------- */

  const revealTargets: Element[] = [];
  revealMeasurements.forEach(({ target, delay, top }) => {
    /* Never hide something already on screen. */
    if (top < initialRevealBoundary) return;
    target.classList.add('scroll-reveal');
    target.style.setProperty('--reveal-delay', `${delay}ms`);
    revealTargets.push(target);
  });
  const revealObserver = new IntersectionObserver((entries) => {
    entries.forEach((entry) => {
      if (!entry.isIntersecting) return;
      entry.target.classList.add('scroll-reveal-in');
      revealObserver.unobserve(entry.target);
    });
  }, { rootMargin: '0px 0px -8% 0px' });
  revealTargets.forEach((target) => revealObserver.observe(target));

  /* ---- shopping motifs on the whitespace rails ------------------------- */

  const CONTAINER_WIDTH = 1140;
  const MOTIF_MIN_VIEWPORT = 1360; /* below this the side band is under ~110px - no room */
  let motifLayer: HTMLElement | null = null;
  let motifs: { node: HTMLElement; speed: number }[] = [];

  const buildMotifs = (measuredDocumentHeight?: number): void => {
    /* On resize, measure before removing the old absolute layer. The first
       build reuses the mount-time read taken before any animation writes. */
    const docHeight = measuredDocumentHeight ?? document.documentElement.scrollHeight;
    motifLayer?.remove();
    motifLayer = null;
    motifs = [];
    if (innerWidth < MOTIF_MIN_VIEWPORT) return;
    const shapes = document.getElementById('motif-shapes') as HTMLTemplateElement | null;
    if (!shapes) return;
    const shapeList = [...shapes.content.querySelectorAll('svg')];
    motifLayer = document.createElement('div');
    motifLayer.className = 'motif-layer';
    motifLayer.setAttribute('aria-hidden', 'true');
    motifLayer.style.height = `${docHeight}px`;
    const field = document.createElement('div');
    field.className = 'motif-field';
    motifLayer.appendChild(field);
    const fieldWidth = Math.min(innerWidth, 1560);
    const band = (fieldWidth - CONTAINER_WIDTH) / 2;
    /* Two rails hugging the container edges, alternating down the page.
       Deterministic jitter (no Math.random) keeps every load identical. */
    const ROW = 400;
    const rows = Math.max(1, Math.floor((docHeight - 320) / ROW));
    let k = 0;
    for (let r = 0; r < rows; r++) {
      if (((r * 7 + 3) % 4) === 0) continue; /* skip ~1 row in 4 to stay sparse */
      const side = r % 2;
      const size = Math.min(80 + ((k * 31) % 70), band - 14);
      const jitterY = ((r * 17 + 5) % 140) - 70;
      const jitterIn = (r * 13) % 24;
      const x = side ? fieldWidth - band + 10 + jitterIn : band - size - 10 - jitterIn;
      const rotation = ((k * 47) % 25) - 12;
      const motif = document.createElement('div');
      motif.className = 'motif';
      motif.style.cssText = `width:${size}px;height:${size}px;top:${160 + r * ROW + jitterY}px;left:${Math.round(Math.max(4, x))}px;rotate:${rotation}deg;`;
      const shape = shapeList[k % shapeList.length].cloneNode(true) as SVGElement;
      shape.style.animationDelay = `${(k * 900) % 4500}ms`;
      motif.appendChild(shape);
      field.appendChild(motif);
      motifs.push({ node: motif, speed: 0.03 + ((k * 3) % 4) * 0.022 });
      k++;
    }
    document.body.appendChild(motifLayer);
  };
  buildMotifs(initialDocumentHeight);

  /* Gentle depth: each motif drifts against the scroll at its own rate.
     Driven by the scroll event through one rAF flag - zero idle cost. */
  let parallaxQueued = false;
  addEventListener('scroll', () => {
    if (parallaxQueued || motifs.length === 0) return;
    parallaxQueued = true;
    requestAnimationFrame(() => {
      parallaxQueued = false;
      motifs.forEach(({ node, speed }) => {
        node.style.transform = `translateY(${-scrollY * speed}px)`;
      });
    });
  }, { passive: true });

  let rebuildTimer = 0;
  addEventListener('resize', () => {
    clearTimeout(rebuildTimer);
    rebuildTimer = window.setTimeout(buildMotifs, 180);
  });
</script>
