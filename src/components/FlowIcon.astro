---
// Identity marks for the three hero flow cards. The cards read as a chain -
// catalogue feeds agent, agent answers customer - and the labels alone made the
// three steps look interchangeable at a glance. Each card now opens with a
// tinted tile carrying its own glyph so the role is legible before the label is
// read.
//
// Hand-built inline SVG, matching DressThumbnail.astro: no icon library, no
// image request, no client JavaScript. Every glyph is drawn on the same 24x24
// canvas at the same stroke weight so the trio reads as one set. Colours live
// in global.css; the paths only use currentColor.
//
// The svg fills the whole tile and carries its inset in the viewBox rather than
// being a smaller centred box. A 17px glyph inside a 28px tile left 5.5px of
// padding either side, so the glyph could not land on a pixel boundary and the
// browser snapped it down and right - visible as an off-centre mark (measured
// and user-reported, 2026-08-23). Padding the viewBox instead makes the glyph
// share the tile's own rect, so it stays centred at any position or zoom.
// Geometry: 24 * 28/17 = 39.5294 units wide, inset -7.7647, which reproduces
// the previous 17px glyph size and 1.2px stroke exactly.

interface Props {
  variant: 'catalogue' | 'agent' | 'customer';
}

const { variant } = Astro.props;
---

<!-- Decorative: the adjacent card label names the step, so the glyph stays out
     of the accessibility tree. -->
<span class:list={['flow-icon', `flow-icon-${variant}`]} aria-hidden="true">
  <svg viewBox="-7.7647 -7.7647 39.5294 39.5294" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round">
    {variant === 'catalogue' && (
      <>
        {/* Product grid: four rounded tiles, the shape of a catalogue listing. */}
        <rect x="3.7" y="3.7" width="7.5" height="7.5" rx="2.2" />
        <rect x="12.8" y="3.7" width="7.5" height="7.5" rx="2.2" />
        <rect x="3.7" y="12.8" width="7.5" height="7.5" rx="2.2" />
        <rect x="12.8" y="12.8" width="7.5" height="7.5" rx="2.2" />
      </>
    )}
    {variant === 'agent' && (
      <>
        {/* Robot face: antenna, rounded head, two eyes, and a mouth line.
            Placed by optical weight, not by its ink box. The head is the mass
            and the antenna is a thin appendage, so centring the full
            antenna-to-chin span drops the head visibly below the tile centre
            (user-reported, 2026-08-23). At this offset the glyph's rendered ink
            centroid sits on the tile centre and the head box is within 0.25px
            of it; its siblings need no offset because they carry no appendage. */}
        <path d="M12 5.65V3.35" />
        <circle cx="12" cy="2.25" r="1.2" fill="currentColor" stroke="none" />
        <rect x="3.9" y="5.65" width="16.2" height="13.4" rx="4.2" />
        <circle cx="9.1" cy="11.45" r="1.15" fill="currentColor" stroke="none" />
        <circle cx="14.9" cy="11.45" r="1.15" fill="currentColor" stroke="none" />
        <path d="M9.7 15.35h4.6" />
      </>
    )}
    {variant === 'customer' && (
      <>
        {/* Shopper: head and shoulders. */}
        <circle cx="12" cy="8.3" r="3.9" />
        <path d="M4.7 20.1a7.3 7.3 0 0 1 14.6 0" />
      </>
    )}
  </svg>
</span>
