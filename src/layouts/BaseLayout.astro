---
import { Font } from 'astro:assets';
import PageMetadata from '../components/head/PageMetadata.astro';
import { site } from '../config/site.ts';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { PageMetadataInput } from '../lib/metadata.ts';
import '../styles/global.css';

interface Props {
  metadata: PageMetadataInput;
}

const { metadata } = Astro.props;
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <PageMetadata metadata={metadata} />
    <link rel="describedby" href="/llms.txt" />
    <link rel="sitemap" href="/sitemap.xml" />
    <link rel="icon" href="/favicon.ico" sizes="16x16 32x32 48x48" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" sizes="any" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
