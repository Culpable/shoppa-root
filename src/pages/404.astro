---
import BaseLayout from '../layouts/BaseLayout.astro';
import type { PageMetadataInput } from '../lib/metadata.ts';

const metadata = {
  title: 'Page Not Found',
  description: 'The requested page could not be found.',
  canonicalPath: '/404.html',
  robots: 'noindex',
  markdownPath: '/404.md',
} satisfies PageMetadataInput;
---

<BaseLayout metadata={metadata}>
  <section class="container not-found">
    <p class="not-found-number">404</p>
    <h1>Page not found</h1>
    <p>Sorry, we couldn’t find the page you’re looking for.</p>
    <p>Agents and crawlers can recover through the <a href="/sitemap.xml">site map</a> or <a href="/llms.txt">agent guide</a>.</p>
    <div class="button-row"><a class="button button-primary" href="/">Go to the home page</a><a class="button button-ghost" href="/#agent">See the agent</a></div>
  </section>
</BaseLayout>
