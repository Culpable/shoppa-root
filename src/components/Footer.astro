---
import { footerNavigation } from '../data/site';

const currentYear = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="container">
    <div class="footer-grid">
      <a class="wordmark footer-wordmark" href="/" aria-label="Shoppa home">shoppa<span aria-hidden="true">.</span></a>
      {footerNavigation.map((column) => (
        <nav aria-label={column.heading}>
          <h2>{column.heading}</h2>
          <ul>
            {column.links.map((link) => <li><a href={link.href}>{link.label}</a></li>)}
          </ul>
        </nav>
      ))}
    </div>
    <div class="footer-bottom">
      <span class="wordmark wordmark-small" aria-hidden="true">shoppa<span>.</span></span>
      <p>© shoppa {currentYear}</p>
    </div>
  </div>
</footer>
