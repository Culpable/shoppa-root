---
import { site } from '../../config/site.ts';
import {
  resolveCanonicalURL,
  resolvePageMetadata,
  type PageMetadataInput,
} from '../../lib/metadata.ts';

interface Props {
  metadata: PageMetadataInput;
}

const { metadata } = Astro.props;
const resolved = resolvePageMetadata(metadata);

if (!Astro.site) {
  throw new Error('Set Astro site to the canonical production origin.');
}

const canonicalURL = resolveCanonicalURL({
  canonicalPath: metadata.canonicalPath,
  currentPath: Astro.url.pathname,
  siteURL: Astro.site,
});

const socialImageURL = resolved.socialImage
  ? new URL(resolved.socialImage.src, Astro.site).toString()
  : undefined;

const markdownURL = resolved.markdownPath
  ? resolveCanonicalURL({
      canonicalPath: resolved.markdownPath,
      currentPath: Astro.url.pathname,
      siteURL: Astro.site,
    })
  : undefined;

// JSON-LD is fixed, trusted build data. Escaping "<" prevents a future value
// from closing the script element if route metadata ever contains HTML-like text.
const structuredDataJSON = resolved.structuredData
  ? JSON.stringify(resolved.structuredData).replaceAll('<', '\\u003c')
  : undefined;
---

<title>{resolved.documentTitle}</title>
<meta name="description" content={resolved.description} />
<link rel="canonical" href={canonicalURL.toString()} />
{markdownURL && (
  <link rel="alternate" type="text/markdown" href={markdownURL.pathname} />
)}
{resolved.robots && <meta name="robots" content={resolved.robots} />}

<meta property="og:title" content={resolved.documentTitle} />
<meta property="og:description" content={resolved.description} />
<meta property="og:type" content={resolved.contentType} />
<meta property="og:url" content={canonicalURL.toString()} />
<meta property="og:site_name" content={site.name} />
<meta property="og:locale" content={site.openGraphLocale} />

<meta name="twitter:card" content={socialImageURL ? 'summary_large_image' : 'summary'} />
<meta name="twitter:title" content={resolved.documentTitle} />
<meta name="twitter:description" content={resolved.description} />

{socialImageURL && resolved.socialImage && (
  <Fragment>
    <meta property="og:image" content={socialImageURL} />
    <meta property="og:image:alt" content={resolved.socialImage.alt} />
    <meta name="twitter:image" content={socialImageURL} />
    <meta name="twitter:image:alt" content={resolved.socialImage.alt} />
    {resolved.socialImage.width && (
      <meta property="og:image:width" content={String(resolved.socialImage.width)} />
    )}
    {resolved.socialImage.height && (
      <meta property="og:image:height" content={String(resolved.socialImage.height)} />
    )}
    {resolved.socialImage.type && (
      <meta property="og:image:type" content={resolved.socialImage.type} />
    )}
  </Fragment>
)}

{structuredDataJSON && (
  <script is:inline type="application/ld+json" set:html={structuredDataJSON} />
)}
