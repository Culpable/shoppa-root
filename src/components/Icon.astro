const CUSTOM = {
  /* Open book with a price tag: a catalogue is a book of products. */
  catalogue: "<path d=\"M12 6.4c-1.6-1.5-4.2-2.2-8.2-2v13.2c4-.2 6.6.5 8.2 2 1.6-1.5 4.2-2.2 8.2-2V4.4c-4-.2-6.6.5-8.2 2z\"/><path d=\"M12 6.4v13.2\"/><path d=\"M6.6 8.4h2.6M6.6 11.4h2.6M6.6 14.4h2.6\"/><path d=\"M14.4 8h3.2l1.2 1.2v3.2l-4.4-4.4z\" fill=\"currentColor\" stroke=\"none\"/>",
  /* Spark-face bot: rounded head, smiling, the chat avatar's spark as antenna.
     The head is the visual mass, the spark a thin appendage; the head box is
     drawn at y 5.6-19 so its centre sits on the canvas centre and the glyph
     centres by optical weight (see DESIGN.md, icon centring). */
  agent: "<path d=\"M12 5.6V3.6\"/><path d=\"M12 1.2c.3 1.1.7 1.5 1.8 1.8-1.1.3-1.5.7-1.8 1.8-.3-1.1-.7-1.5-1.8-1.8 1.1-.3 1.5-.7 1.8-1.8z\" fill=\"currentColor\" stroke=\"none\"/><rect x=\"3.9\" y=\"5.6\" width=\"16.2\" height=\"13.4\" rx=\"4.4\"/><path d=\"M8.2 11.2c.6-.9 1.6-.9 2.2 0\"/><path d=\"M13.6 11.2c.6-.9 1.6-.9 2.2 0\"/><path d=\"M8.9 14.4c1.6 1.9 4.6 1.9 6.2 0\"/>",
  /* Shopper with a filled shopping bag, bag large enough to read at 28px. */
  customer: "<circle cx=\"9.2\" cy=\"7.1\" r=\"3.3\"/><path d=\"M2.8 19.7a6.2 6.2 0 0 1 8.6-5.6\"/><path d=\"M13.2 12.5h7.6l-.7 7.6h-6.2z\" fill=\"currentColor\" stroke=\"none\"/><path d=\"M15 12.5v-1.4a2 2 0 0 1 4 0v1.4\"/>",
} as const;

export type IconName = keyof typeof PHOSPHOR | keyof typeof CUSTOM;
export type IconTone = 'peach' | 'terracotta' | 'blush' | 'band' | 'sage';

interface Props {
  name: IconName;
  /** Render inside a tinted rounded tile of this tone. Omit for an inline 1em glyph. */
  tile?: IconTone;
  /** Tile edge in px (default 28, the hero flow-tile size). Ignored inline. */
  size?: number;
  class?: string;
}

const { name, tile, size = 28, class: className } = Astro.props;
const isCustom = name in CUSTOM;
const markup = isCustom ? CUSTOM[name as keyof typeof CUSTOM] : PHOSPHOR[name as keyof typeof PHOSPHOR];
const viewBox = tile
  ? (isCustom ? '-7.7647 -7.7647 39.5294 39.5294' : '-57.5 -57.5 371 371')
  : (isCustom ? '0 0 24 24' : '0 0 256 256');
const svgAttrs = isCustom
  ? ({ fill: 'none', stroke: 'currentColor', 'stroke-width': '1.7', 'stroke-linecap': 'round', 'stroke-linejoin': 'round' } as const)
  : ({ fill: 'currentColor' } as const);
---

<span
  class:list={[tile ? 'icon-tile' : 'icon-inline', tile && `icon-tile-${tile}`, className]}
  style={tile && size !== 28 ? `--icon-tile: ${size}px` : undefined}
  aria-hidden="true"
>
  <svg viewBox={viewBox} {...svgAttrs} set:html={markup} />
</span>
