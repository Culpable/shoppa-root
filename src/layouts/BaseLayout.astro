---
import { Font } from 'astro:assets';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { PageMetadata } from '../data/site';
import { site } from '../data/site';
import '../styles/global.css';

interface Props {
  metadata: PageMetadata;
}

const { metadata } = Astro.props;
const title = metadata.path === '/' ? metadata.title : `${metadata.title} / Shoppa`;
const canonical = new URL(metadata.path, site.origin);
---

<!doctype html>
<html lang={site.locale}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={metadata.description} />
    <link rel="canonical" href={canonical} />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={metadata.description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:site_name" content="Shoppa" />
    <meta property="og:locale" content="en_AU" />
    <meta name="twitter:card" content="summary" />
    {!metadata.indexable && <meta name="robots" content="noindex" />}
    <link rel="describedby" href="/llms.txt" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="icon" href="/favicon.ico" sizes="any" />
    <link rel="icon" href="/icon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-icon.png" />
    <Font cssVariable="--font-display" preload />
    <Font cssVariable="--font-body" preload />
    <Font cssVariable="--font-mono" />
  </head>
  <body>
    <a class="skip-link" href="#main-content">Skip to content</a>
    <Header currentPath={Astro.url.pathname} />
    <main id="main-content"><slot /></main>
    <Footer />
  </body>
</html>
