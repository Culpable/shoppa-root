---
import { headerNavigation } from '../data/site';

interface Props {
  currentPath: string;
}

const { currentPath } = Astro.props;

// Fragment targets are sections, not the current page. Mark only real route links.
function isCurrent(href: string): boolean {
  if (href.startsWith('/#')) return false;
  return currentPath === href;
}
---

<header class="site-header">
  <div class="container header-inner">
    <a class="wordmark" href="/" aria-label="Shoppa home">shoppa<span aria-hidden="true">.</span></a>
    <nav class="header-nav" aria-label="Main navigation">
      <ul>
        {headerNavigation.map((link) => (
          <li>
            <a href={link.href} aria-current={isCurrent(link.href) ? 'page' : undefined}>
              {link.label}
            </a>
          </li>
        ))}
      </ul>
    </nav>
    <a class="button button-primary button-compact" href="/contact/">Contact us</a>
  </div>
</header>
