{
  "name": "shoppa-root",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.22.0",
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build": "wrangler types && astro check && astro build",
    "build:worker": "pnpm build && node --experimental-strip-types scripts/generate-agent-markdown.mjs dist https://shoppa.au && node scripts/publish-headers.mjs",
    "preview": "astro preview",
    "test": "pnpm test:unit && pnpm test:build-output && playwright test",
    "test:unit": "node --experimental-strip-types --test test/*.test.ts",
    "test:build-output": "node scripts/validate-build.mjs",
    "test:agent-a11y": "playwright test test/agent-accessibility.spec.ts",
    "test:http": "node scripts/run-http-contract.mjs",
    "worker:dev": "wrangler dev",
    "worker:types": "wrangler types",
    "deploy": "wrangler deploy --env=\"\"",
    "deploy:preview": "wrangler versions upload --env preview"
  },
  "dependencies": {
    "astro": "7.2.2"
  },
  "devDependencies": {
    "@astrojs/check": "0.9.10",
    "@axe-core/playwright": "4.13.0",
    "@playwright/test": "1.62.1",
    "parse5": "8.0.1",
    "typescript": "6.0.3",
    "wrangler": "4.129.0"
  }
}
